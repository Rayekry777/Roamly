# Copy to .env and load these values in the IDE or deployment environment.
DB_HOST=
DB_PORT=3306
DB_NAME=ray-roamly
DB_USERNAME=root
DB_PASSWORD=change-me
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0
SERVER_PORT=8081
MEDIA_STORAGE_ROOT=./uploads
MEDIA_TEMPORARY_RETENTION_HOURS=24
MEDIA_CLEANUP_INITIAL_DELAY_MS=60000
MEDIA_CLEANUP_INTERVAL_MS=3600000
SPRING_PROFILES_ACTIVE=dev
SMS_MOCK_CODE=123456
# 至少 32 字节随机值；生产环境必须通过外部环境变量注入。
RAY_QR_HMAC_SECRET=change-me-to-a-random-secret
RAY_MERCHANT_INVITATION_HMAC_SECRET=dev-only-merchant-invitation-secret-change-in-production
OBJECT_STORAGE_MODE=LOCAL
OBJECT_STORAGE_LOCAL_BUCKET=roamly-business-local
BUSINESS_MEDIA_TEMPORARY_RETENTION_HOURS=24
# 生产 S3 模式必须提供以下变量，不提供安全默认值。
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=cn-east-1
# S3_BUCKET=roamly-business
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE_ACCESS=true
